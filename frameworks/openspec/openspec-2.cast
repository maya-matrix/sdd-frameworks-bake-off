[0.067, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[20S\u001b[r\u001b[H\u001b[7G\u001b[38;2;248;248;242m\u001b[2m26\u001b[10G\u001b[22m \u001b[39m\u001b[K\r\u001b[13B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mExpenses can now be split by exact amounts or by percentages,\u001b[65Gand\u001b[69Gall\u001b[73G14\u001b[76Gtasks\u001b[82Gin\u001b[85G\u001b[38;2;177;185;249madd-unequal-splits\u001b[104G\u001b[39mare\u001b[108Gdone.\u001b[114GEqual\u001b[120Gsplits\u001b[127Gwork\u001b[132Gas\u001b[135Gbefore,\u001b[143Gand\u001b[147Gthe\u001b[151Gbalances\r\u001b[1B  response format is unchanged. Typecheck, build and \u001b[38;2;177;185;249mopenspec validate --strict\u001b[39m all pass, and\u001b[95Gall\u001b[99G179\u001b[103Gtests\u001b[109Gpass,\u001b[115Gincluding\u001b[125Gthe\u001b[129Goriginal\u001b[138Gones.\r\u001b[2C\u001b[2B\u001b[1mHow it works:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mRequest:\u001b[14G\u001b[22ma\u001b[16Gnew\u001b[20Goptional\u001b[29G\u001b[38;2;177;185;249msplitType\u001b[39G\u001b[39m(\u001b[38;2;177;185;249mequal\u001b[39m,\u001b[47G\u001b[38;2;177;185;249mexact\u001b[53G\u001b[39mor\u001b[56G\u001b[38;2;177;185;249mpercentage\u001b[39m)\u001b[68Gplus\u001b[73Ga\u001b[75G\u001b[38;2;177;185;249msplits\u001b[82G\u001b[39mlist.\u001b[88GLeaving\u001b[96Gout\u001b[100G\u001b[38;2;177;185;249msplitType\u001b[110G\u001b[39mmeans\u001b[116G\u001b[38;2;177;185;249mequal\u001b[39m,\u001b[123Gso\u001b[126Gexisting\u001b[135Greq"]
[0.001, "o", "uests\u001b[144Gbehave\u001b[151Gexactly\u001b[159Gas\r\u001b[4C\u001b[1Bbefore.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mExact splits:\u001b[19G\u001b[22mthe\u001b[23Gamounts\u001b[31Gmust\u001b[36Gadd\u001b[40Gup\u001b[43Gto\u001b[46Gthe\u001b[50Gexpense\u001b[58Gtotal\u001b[64Gto\u001b[67Gthe\u001b[71Gcent,\u001b[77Gor\u001b[80Gthe\u001b[84Grequest\u001b[92Gis\u001b[95Grejected\u001b[104Gwith\u001b[109Ga\u001b[111G400\u001b[115Gerror.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPercentage splits:\u001b[24G\u001b[22mpercentages\u001b[36Gare\u001b[40Gstrings\u001b[48Gwith\u001b[53Gup\u001b[56Gto\u001b[59Gtwo\u001b[63Gdecimals\u001b[72Gand\u001b[76Gmust\u001b[81Gadd\u001b[85Gup\u001b[88Gto\u001b[91Gexactly 100.\u001b[104GShares\u001b[111Gare\u001b[115Grounded\u001b[123Gdown\u001b[128Gto\u001b[131Gwhole\u001b[137Gcents,\u001b[144Gand\u001b[148Gthe\u001b[152Gleftover\u001b[161Gcents\r\u001b[4C\u001b[1Bgo\u001b[8Gto\u001b[11Gwhoever\u001b[19Gwas\u001b[23Grounded\u001b[31Gdown\u001b[36Gthe\u001b[40Gmost.\u001b[46GTies\u001b[51Ggo\u001b[54Gto\u001b[57Gwhoever\u001b[65Gjoined\u001b[72Gthe\u001b[76Ggroup\u001b[82Gfirst,\u001b[89Gand\u001b[93Gthe\u001b[97Gorder\u001b[103Gof\u001b[106Gthe\u001b[110Grequest\u001b[118Glist\u001b[123Gdoesn't\u001b[131Gmatter.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mValidation:\u001b[17G\u001b[22mbad\u001b[21Gcombinations\u001b[34Gare\u001b[38Grejected\u001b[47Gwith\u001b[52Ga\u001b[54G400\u001b[58Gerror\u001b[64Gbefore\u001b[71Ganything\u001b[80Gis\u001b[83Gsaved.\u001b[90GThat\u001b[95Gcovers\u001b[102Gsending\u001b[110Gboth\u001b[115G"]
[0.001, "o", "\u001b[38;2;177;185;249msplitBetween\u001b[128G\u001b[39mand\u001b[132G\u001b[38;2;177;185;249msplits\u001b[39m,\u001b[140Ga\u001b[142Gpercentage\u001b[153Gin\u001b[156Gan\u001b[159Gexact\r\u001b[4C\u001b[1Bsplit\u001b[11Gor\u001b[14Gan\u001b[17Gamount\u001b[24Gin\u001b[27Ga\u001b[29Gpercentage\u001b[40Gsplit,\u001b[47Gduplicates,\u001b[59Gnon-members,\u001b[72Gand\u001b[76Gsums\u001b[81Gthat\u001b[86Gare\u001b[90Goff.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mResponses:\u001b[16G\u001b[22mevery\u001b[22Gexpense\u001b[30Gnow\u001b[34Gincludes\u001b[43G\u001b[38;2;177;185;249msplitType\u001b[39m.\u001b[54GExact\u001b[60Gand\u001b[64Gpercentage\u001b[75Gexpenses\u001b[84Galso\u001b[89Greturn\u001b[96Gtheir\u001b[102G\u001b[38;2;177;185;249msplits\u001b[39m,\u001b[110Gand\u001b[114G\u001b[38;2;177;185;249msplitBetween\u001b[127G\u001b[39mis\u001b[130Gstill\u001b[136Greturned\u001b[145Gfor\u001b[149Gevery\u001b[155Gexpense.\r\u001b[4C\u001b[1BEqual-split\u001b[17Gresponses\u001b[27Gonly\u001b[32Ggain\u001b[37Gthe\u001b[41G\u001b[38;2;177;185;249msplitType\u001b[51G\u001b[39mfield.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBalances and settle-up:\u001b[29G\u001b[22mno\u001b[32Gcode\u001b[37Gchanges\u001b[45Gwere\u001b[50Gneeded.\u001b[58GA\u001b[60Gnew\u001b[64Gtest\u001b[69Gfixes\u001b[75Gthe\u001b[79Gbalances\u001b[88Gresponse\u001b[97Gto\u001b[100Gexactly\u001b[108G\u001b[38;2;177;185;249mmemberId\u001b[39m,\u001b[118G\u001b[38;2;177;185;249mname\u001b[123G\u001b[39mand\u001b[127G\u001b[38;2;177;18"]
