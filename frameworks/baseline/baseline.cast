[0.001, "o", ";242m \u001b[38;2;166;226;46mMoneyError\u001b[38;2;248;248;242m \u001b[38;2;249;38;114mextends\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mError\u001b[38;2;248;248;242m {}\r\u001b[5C\u001b[1B\u001b[2m  6 \r\u001b[1B\u001b[22m\u001b[39m \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m  7 \u001b[22m\u001b[38;2;117;113;94m// Up to 15 integer digits keeps any realistic total far from 64-bit limits.\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  8 \u001b[22m\u001b[38;2;102;217;239mconst\u001b[38;2;248;248;242m \u001b[38;2;255;255;255mAMOUNT_RE\u001b[38;2;248;248;242m = \u001b[38;2;230;219;116m/^(0|[1-9]\\d{0,14})(?:\\.(\\d{1,2}))?$/\u001b[38;2;248;248;242m;\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m  9 \u001b[22m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;248;248;242m\u001b[2m 10 \u001b[22m\u001b[38;2;117;113;94m/** Parse a positive decimal string such as \"12.5\" or \"12.50\" into cents. */\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +32 lines \r\u001b[2B⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=16yb0h;file:///Users/maya/Workspace/sdd-bake-off/frameworks/baseline/src/settle.js\u0007src/settle.js\u001b]8;;\u0007)\r\u001b[2B\u001b[38;2;153;153;153m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=79sj0t;file:///Users/maya/Workspace/sdd-bake-off/framew"]
