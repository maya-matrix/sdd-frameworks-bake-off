[0.371, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[4S\u001b[r\u001b[H\u001b[3G│ App       │ \u001b[38;2;177;185;249msrc/app.ts\u001b[39m, \u001b[38;2;177;185;249msrc/server.ts\u001b[39m                      │ Builds a fresh app with fresh storage each time; starts the server                               │\r\u001b[33C\u001b[29B)\u001b[47G✅\r\u001b[2C\u001b[3B\u001b[1mChanges and additions to the canvas\r\u001b[2C\u001b[2B\u001b[22m-\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.510, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[4C\u001b[34B\u001b[1mWrong numbers in the canvas, not in the code.\u001b[51G\u001b[22mThe\u001b[55Gend-to-end\u001b[66Gexample\u001b[74Gin\u001b[77GTask\u001b[82G16\u001b[85Gexpected\u001b[94Gbalances\u001b[103GA\u001b[105G+60.00,\u001b[113GB\u001b[115G0.00,\u001b[121GC\u001b[123G−60.00.\u001b[131GThe\u001b[135Gcorrect\u001b[143Gvalues\u001b[150Gare\u001b[154GA\u001b[156G+60.00,\u001b[164GB\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.271, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[2S\u001b[r\u001b[H\u001b[5GTests\u001b[17G\u001b[38;2;177;185;249mtests/unit/\u001b[39m, \u001b[38;2;177;185;249mtests/api/\u001b[39m  \u001b[66GExample test\u001b[79G,\u001b[81Gproper\u001b[88Gy-based\u001b[96Gtests, and endpoint \u001b[117Ges\u001b[122Gcovering every\u001b[137Gendpoint\u001b[146Gand\u001b[150Gerror\u001b[156Gcode\r\u001b[4C\u001b[33B−15.00,\u001b[13GC\u001b[15G−45.00,\u001b[23Gand\u001b[27Gsettle-up\u001b[37Ggives\u001b[43Gtwo\u001b[47Gtransfers.\u001b[58GI\u001b[60Gfixed\u001b[66Gthe\u001b[70Gcanvas\u001b[77Gfirst,\u001b[84Gthen\u001b[89Gthe\u001b[93Gtest.\r\u001b[2C\u001b[1B-\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
