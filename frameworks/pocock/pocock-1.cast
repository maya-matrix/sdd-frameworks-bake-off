[0.016, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[3T\u001b[r\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m   +\u001b[38;2;248;248;242mse's Shares add up exactly to its Amount, and every Group's Balances add up exactly to zero. Changing the Remainder rule later would change historical\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m   +\u001b[38;2;248;248;242m Balances, so it is treated as fixed.                                                                                                                 \r\u001b[1B\u001b[49m\u001b[38;2;153;153;153m  ⎿  (what this command changed; a convenience view, not a review or audit of the command)\r\u001b[70C\u001b[31B\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (click) ↓ \u001b[39m\u001b[49m\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
