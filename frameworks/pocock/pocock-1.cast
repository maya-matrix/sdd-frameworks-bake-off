[0.001, "o", "                                                                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 20 +\u001b[38;2;102;217;239mdef\u001b[38;2;248;248;242m \u001b[38;2;166;226;46msettle_up\u001b[38;2;248;248;242m(\u001b[38;2;253;151;31mbalances: \u001b[38;2;166;226;46mSequence\u001b[38;2;253;151;31m[\u001b[38;2;166;226;46mtuple\u001b[38;2;253;151;31m[\u001b[38;2;166;226;46mstr\u001b[38;2;253;151;31m, \u001b[38;2;166;226;46mint\u001b[38;2;253;151;31m]]\u001b[38;2;248;248;242m) -> SettleUpResult:                                                                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 21 +\u001b[38;2;248;248;242m    \u001b[38;2;230;219;116m\"\"\"Suggest transfers for (member_id, Balance) pairs that sum to zero.\u001b[38;2;248;248;242m                                                                            \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m22 +\u001b[38;2;248;248;242m         \u001b[21G    \u001b[26G                                                                                                                                      \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m23\u001b[10G+\u001b[38;2;248;248;242m    T"]
[0.001, "o", "he order of `balances` \u001b[38;2;249;38;114mis\u001b[38;2;248;248;242m the stable Member ordering used to \u001b[38;2;249;38;114mbreak\u001b[38;2;248;248;242m ties.                                                                        \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m24 +\u001b[38;2;248;248;242m    \u001b[38;2;230;219;116m\"\"\"\u001b[38;2;248;248;242m                                                                                                                                              \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m25\u001b[10G+\u001b[38;2;248;248;242m    nonzero = [(member_id,\u001b[38Gbalance)\u001b[47G\u001b[38;2;249;38;114mfor\u001b[38;2;248;248;242m member_id, balance \u001b[38;2;249;38;114min\u001b[38;2;248;248;242m balances \u001b[38;2;249;38;114mif\u001b[38;2;248;248;242m balance != \u001b[38;2;190;132;255m0\u001b[38;2;248;248;242m]                                                              \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m26 +\u001b[38;2;248;248;242m    \u001b[38;2;249;38;114mreturn\u001b[38;2;248;248;242m SettleUpResult(transfers=_greedy(nonzero), optimal=\u001b[38;2;190;132;255mTrue\u001b[38;2;248;248;242m)                    "]
