[0.059, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[23S\u001b[r\u001b[H\u001b[7G\u001b[38;2;248;248;242m\u001b[2m85\u001b[11G\u001b[22m    ids = {member_id \u001b[38;2;249;38;114mfor\u001b[38;2;248;248;242m member_id, _ \u001b[38;2;249;38;114min\u001b[38;2;248;248;242m balances}\r\u001b[5B\u001b[38;2;78;186;101m⏺\u001b[3G\u001b[39m\u001b[1mBash\u001b[22m(perl\u001b[13G-pi -e 's/pair the\u001b[32Glargest\u001b[40Gdebtor\u001b[47Gwith\u001b[52Gthe\u001b[56Glargest\u001b[64Gcreditor/pair\u001b[78Gthe\u001b[82GMember\u001b[89Gowing\u001b[95Gthe\u001b[99Gmost\u001b[104Gwith\u001b[109Gthe\u001b[113GMember\u001b[120Gowed\u001b[125Gthe\u001b[129Gmost/'\r\u001b[1B      docs/adr/0001-exact-minimum-sett…)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39m1\u001b[K\r\u001b[5C\u001b[1B5fd4ec6 Align names\u001b[26Gwith\u001b[31Gthe\u001b[35GCONTEXT.md\u001b[46Gglossary\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mUpdated\u001b[14G\u001b[1mdocs/adr/0001-exact-minimum-settle-up.md\u001b[55G\u001b[22m\u001b[38;2;153;153;153m(+1 -1)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m 1 \u001b[22m # Settle-up computes the true minimum number of transfers, with a greedy fallback\r\u001b[1B\u001b[39m     \u001b[38;2;248;248;242m\u001b[2m 2 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 3 -\u001b[38;2;248;248;242mMinimising the number of trans"]
[0.002, "o", "fers that clear all Balances is NP-hard: it is equivalent to partitioning the non-zero Balances into as many zero-sum su\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m   -\u001b[38;2;248;248;242mbgroups as possible, since a subgroup of k Members needs k−1 transfers. The common greedy algorithm (pair the \u001b[48;2;92;2;0mlargest\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mdebtor\u001b[48;2;61;1;0m with the \u001b[48;2;92;2;0mlargest\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mcreditor\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m   -\u001b[38;2;248;248;242m) guarantees at most n−1 transfers but is not always optimal. The brief explicitly asks for the *minimum*, so we search subsets exactly when the numbe\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m   -\u001b[38;2;248;248;242mr of Members with non-zero Balances is small enough to be practical, and fall back to greedy above that threshold. This means the result is guaranteed\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m   -\u001b[38;2;248;248;242m minimal only below the threshold.                                                                                                            "]
[0.001, "o", "        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 3 +\u001b[38;2;248;248;242mMinimising the number of transfers that clear all Balances is NP-hard: it is equivalent to partitioning the non-zero Balances into as many zero-sum su\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m   +\u001b[38;2;248;248;242mbgroups as possible, since a subgroup of k Members needs k−1 transfers. The common greedy algorithm (pair the \u001b[48;2;4;71;0mMember\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mowing\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mthe most \u001b[48;2;2;40;0mwith the \u001b[48;2;4;71;0mMember\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mow\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m   +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0med the most\u001b[48;2;2;40;0m) guarantees at most n−1 transfers but is not always optimal. The brief explicitly asks for the *minimum*, so we search subsets exactly whe\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m   +\u001b[38;2;248;248;242mn the number of Members with non-zero Balances is small enough to be practical, and fall back to greedy above that threshold. This means the result is\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m   +\u001b[38"]
[0.001, "o", ";2;248;248;242m guaranteed minimal only below the threshold.                                                                                                         \r\u001b[1B\u001b[49m\u001b[38;2;153;153;153m  ⎿  \u001b[39mUpdated\u001b[14G\u001b[1mpocock-1.cast\u001b[28G\u001b[22m\u001b[38;2;153;153;153m(+2 -0)\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 11170 \u001b[22m [0.102, \"o\", \"\\u001b[?2026h\\u001b[?25l\\u001b[H\\r\\u001b[33B\\u001b[38;2;215;119;87m✻\\u001b[39m\\u001b[40;1H\\u001b[38;3H\\u001b[?25h\\u001b[?2026l\"]\r\u001b[5C\u001b[1B\u001b[2m 11171 \u001b[22m [0.035, \"o\", \"\\u001b[?2026h\\u001b[?25l\\u001b[H\\r\\u001b[28B\\u001b[38;2;153;153;153m \\u001b[39m\\u001b[40;1H\\u001b[38;3H\\u001b[?25h\\u001b[?2026l\"]\r\u001b[5C\u001b[1B\u001b[2m 11172 \u001b[22m [0.149, \"o\", \"\\u001b[?2026h\\u001b[?25l\\u001b[H\\r\\u001b[2C\\u001b[28BAlign ADR\\u001b[13Gwording and commit\\u001b[32Grenames\\r\\u001b[2C\\u001b[5B\\u001\r\u001b[5C\u001b[1B\u001b[2m       \u001b[22m b[38;2;233;154;122mHerding…\\u001b[39m\\u001b[40;1H\\u001b[38;3H\\u001b[?25h\\u001b[?2026l\"]\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 11173 +\u001b[38;2;248;248;242m[0.050, \"o\", \"\\u001b[?2026h\\u001b[?25l\\u"]
