[0.313, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[3C\u001b[31B\u001b[38;2;177;185;249mmattpocock-skills:\u001b[1mgr\u001b[22milling\u001b[31G(grilling)\u001b[58G(mattpocock-skills) \u001b[1mGr\u001b[22mill the user relentlessly about a plan, decision, or idea. Use when the user wants to\r\u001b[2C\u001b[1B\u001b[39m                                                       \u001b[38;2;177;185;249mstress-test their thinking, or uses any '\u001b[1mgr\u001b[22mill' trigger phrases.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m/mattpocock-skills:\u001b[39m\u001b[1mgr\u001b[22m\u001b[38;2;153;153;153mill-me (grill-me)                 (m\u001b[61Gttpocock-skills) A rel\u001b[84Gn\u001b[86Gle\u001b[89Gs intervi\u001b[99Gw to sharpen a\u001b[114Gplan or design.\u001b[39m\u001b[K\r\u001b[22C\u001b[1B\u001b[1mr\u001b[27G\u001b[22m\u001b[38;2;153;153;153m-with-docs (\u001b[40Grill-with-docs)\u001b[78GA re\u001b[83Gentles\u001b[90G int\u001b[95Grview to sh\u001b[107Grpen\u001b[118G or de\u001b[126Gg\u001b[130Gwhich \u001b[137Glso creates docs (ADR's and\u001b[39m\u001b[K\r\u001b[57C\u001b[1B\u001b[38;2;153;153;153mglos\u001b[63Gary) as w\u001b[73G go.\u001b[39m\u001b[K\r\u001b[4C\u001b[2Br\u001b[40;1H\u001b[38;6H\u001b[?25h\u001b[?2026l"]
[3.439, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[31B\u001b[38;2;153;153;153m/mattpocock-skills:\u001b[39m\u001b[1mgr\u001b[22m\u001b[38;2;153;153;153milling (grilling)                 (mattpocock-skills) \u001b[39m\u001b[1mGr\u001b[22m\u001b[38;2;153;153;153mill the user relentlessly about a plan, decision, or idea. Use when the user wants to\r\u001b[57C\u001b[1Bstress-test their thinking, or uses any '\u001b[39m\u001b[1mgr\u001b[22m\u001b[38;2;153;153;153mill' trigger phrases.\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m/mattpocock-skills:\u001b[1mgr\u001b[22mill-me (grill-me)                 (mattpocock-skills) A relentless interview to sharpen a plan or design.\u001b[39m\u001b[40;1H\u001b[38;6H\u001b[?25h\u001b[?2026l"]
