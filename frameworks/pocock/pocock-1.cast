[0.016, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[4S\u001b[r\u001b[H\r\u001b[70C\u001b[30B\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mBlocking edges:\u001b[22G\u001b[22m6\u001b[24Gwaits\u001b[30Gfor\u001b[34G5\u001b[36Gonly\u001b[41Gbecause\u001b[49Gof\u001b[52Gthe\u001b[56Gend-to-end\u001b[67G\"settle\u001b[75Gby\u001b[78Grecording\u001b[88GPayments\"\u001b[98Gtest.\u001b[104GWithout\u001b[112Gthat\u001b[117Gtest,\u001b[123G6\u001b[125Gcould\u001b[131Gstart\u001b[137Gright\u001b[143Gafter\u001b[149G2\u001b[151Gand 4.\u001b[158GI'd\u001b[162Gkeep\r\u001b[5C\u001b[1Bthe\u001b[10Gdependency\u001b[21Gon 5.\r\u001b[2C\u001b[1B3.\u001b[6GShould\u001b[13Gany\u001b[17Gtickets\u001b[25Gbe\u001b[28Gmerged\u001b[35Gor\u001b[38Gsplit?\r\u001b[70C\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (click) ↓ \u001b[39m\u001b[49m\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.017, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m6. Settle-up endpoint\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mBlocked by:\u001b[22m 2, 5\u001b[K\r\u001b[4C\u001b[1B\u001b[1mWhat it\u001b[13Gdelivers:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- \u001b[38;2;177;185;249mGET /groups/{id}/settle-up\u001b[34G\u001b[39mreturns\u001b[42G\u001b[38;2;177;185;249m{transfers, optimal}\u001b[39m,\u001b[64Gwith\u001b[69Gan\u001b[72Gempty\u001b[78Glist\u001b[83Gwhen\u001b[88Geveryone\u001b[97Gis\u001b[100Gsettled.\r\u001b[6C\u001b[1BEnd-to-end test: recording\u001b[34Gevery Suggested Transfer as a\u001b[64GPayment\u001b[72Gbrings all\u001b[83GBalances t\u001b[94G zero.\u001b[K\r\u001b[6C\u001b[1BA test with more\u001b[24Gthan 16 Memb\u001b[38Gs\u001b[40Gcheck\u001b[46G the greedy f\u001b[60Gllback and \u001b[38;2;177;185;249moptimal: false\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m7. Delete Expenses and Payments\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mBlocked\u001b[13Gby:\u001b[22m 5\u001b[K\r\u001b[4C\u001b[1B\u001b[1mWhat it\u001b[13Gdelivers:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- \u001b[38;2;177;185;249mDELETE\u001b[39m for Expenses\u001b[27Gand\u001b[31GPayments\u001b[40Greturns\u001b[48G204,\u001b[53Gand\u001b[57GBalances\u001b[66Gupdate\u001b[73Gto\u001b[76Gmatch.\r\u001b[6C\u001b[1B404 for an\u001b[18Gunknown Expense or Paym\u001b[42Gnt, or one\u001b[53Gfrom \u001b[59Gnoth\u001b[64Gr\u001b[66GGroup.\u001b[73G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2"]
