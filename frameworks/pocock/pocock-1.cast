[0.074, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 28 +\u001b[38;2;248;248;242m**Expense**:                                                                                                                                         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 29 +\u001b[38;2;248;248;242mA record that one Member (the Payer) paid an Amount for something, split equally among a set of Participants.                                        \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m  \u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 30 +\u001b[38;2;248;248;242m_Avoid_: Bill, transaction, charge                                                                                                                   \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m \u001b[5G \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 31 +\u001b[38;2;248;248;242m                                                                                                                                                     \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m \u001b[5G \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 32 +\u001b[38;2;248;248;242m**Payer**:                                                 "]
[0.023, "o", "                                                                                          \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m \u001b[5G \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 33 +\u001b[38;2;248;248;242mThe Member who paid the Expense's Amount. The Payer does not have to be a Participant.                                                               \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m \u001b[5G \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 34 +\u001b[38;2;248;248;242m                                                                                                                                                     \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m \u001b[5G \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 35 +\u001b[38;2;248;248;242m**Participant**:                                                                                                                                     \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m \u001b[5G \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 36 +\u001b[38;2;248;248;242mA Member whom an Expense is split between, and who therefore owes a Share of it.                                                                     \r\u001b[5C\u001b[1B\u001b[38;2;80"]
[0.004, "o", ";200;80m 37 +\u001b[38;2;248;248;242m_Avoid_: Splitter, debtor, beneficiary                                                                                                               \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m  \u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 38 +\u001b[38;2;248;248;242m                                                                                                                                                     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 39 +\u001b[38;2;248;248;242m**Share**:                                                                                                                                           \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 40 +\u001b[38;2;248;248;242mThe whole-minor-unit portion of an Expense's Amount owed by one Participant. Within one Expense, the Shares add up exactly to the Amount.            \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;2;153;153;153m… 22 more lines \r\u001b[1B  ⎿  \u001b[39mCreated \u001b[1mdocs/adr/0001-exact-minimum-settle-up.md\u001b[22m \u001b[38;2;153;153;153m(+3 -0)\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;80;200;80m"]
[0.001, "o", "\u001b[48;2;2;40;0m 1 +\u001b[38;2;248;248;242m# Settle-up computes the true minimum number of transfers, with a greedy fallback                                                                     \u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 2 +\u001b[38;2;248;248;242m                                                                                                                                                      \u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 3 +\u001b[38;2;248;248;242mMinimising the number of transfers that clear all Balances is NP-hard: it is equivalent to partitioning the non-zero Balances into as many zero-sum su\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m   +\u001b[38;2;248;248;242mbgroups as possible, since a subgroup of k Members needs k−1 transfers. The common greedy algorithm (pair the largest debtor with the largest creditor\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m   +\u001b[38;2;248;248;242m) guarantees at most n−1 transfers but is not always optimal. The brief exp"]
[0.002, "o", "licitly asks for the *minimum*, so we search subsets exactly when the numbe\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m   +\u001b[38;2;248;248;242mr of Members with non-zero Balances is small enough to be practical, and fall back to greedy above that threshold. This means the result is guaranteed\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m   +\u001b[38;2;248;248;242m minimal only below the threshold.                                                                                                                    \u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mCreated \u001b[1mdocs/adr/0002-integer-minor-units-with-remainder-rule.md\u001b[22m \u001b[38;2;153;153;153m(+3 -0)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1 +\u001b[38;2;248;248;242m# Money is stored as integer minor units; equal-split Remainders go to Participants by a deterministic rule                                           \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 2 +\u001b[38;2;248;248;242m                                               "]
[0.001, "o", "                                                                                                       \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 3 +\u001b[38;2;248;248;242m\"Exact, no rounding errors\" can be met either with rational Balances (e.g. 1000/3 cents) or with whole-minor-unit Shares that add up exactly to the Am\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m   +\u001b[38;2;248;248;242mount. We chose integer minor units. Nobody can pay a fraction of a cent, so rational Balances would only push the rounding problem into Settle-up. Ins\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m   +\u001b[38;2;248;248;242mtead, each Expense splits into whole-unit Shares, and its Remainder is handed out one unit at a time by a deterministic rule. As a result, every Expen\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m   +\u001b[38;2;248;248;242mse's Shares add up exactly to its Amount, and every Group's Balances add up exactly to zero. Changing the Remainder rule later would change historical\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m   +\u001b[38;2;248;248;242m Balances, so it is treated as fixed.              "]
[0.001, "o", "                                                                                                   \r\u001b[1B\u001b[49m\u001b[38;2;153;153;153m  ⎿  (what this command changed; a convenience view, not a review or audit of the command)\r\u001b[1B  ⎿  \u001b[7Gllow\u001b[14Gby auto mod\u001b[26G classifie\u001b[37G\u001b[39m\u001b[K\r\u001b[16C\u001b[2B\u001b[38;2;153;153;153m28s · ↓\u001b[39m \u001b[38;2;153;153;153m2.5k t\u001b[32Gkens)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
