[0.106, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m✽\u001b[3G\u001b[38;2;230;149;117mLeavening…\u001b[39m\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.024, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 19 -\u001b[38;2;248;248;242m- [\u001b[48;2;92;2;0m \u001b[48;2;61;1;0m] Join order is recorded for each Member, ready for the Remainder rule in later tickets.                                                         \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 20 -\u001b[38;2;248;248;242m- [\u001b[48;2;92;2;0m \u001b[48;2;61;1;0m] All tests go through the HTTP test client against a temporary database. No test touches SQL directly.                                          \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m14\u001b[10G+\u001b[38;2;248;248;242m- [\u001b[48;2;4;71;0mx\u001b[48;2;2;40;0m]\u001b[17G`POST\u001b[23G/groups`\u001b[32Gwith\u001b[37G`{name,\u001b[45Gcurrency, members?}` returns 2\u001b[77G with the Group (UUID id, na\u001b[106Ge, currency, created_at) and its Membe\u001b[145Gs (id,\u001b[152Gname).\u001b[159G \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m15\u001b[10G+\u001b[38;2;248;248;242m- [\u001b[48;2;4;71;0mx\u001b[48;2;2;40;0m] The Cur\u001b[25Gency must be an ISO 4217 code on the 2-decimal allow-list (e.g. EUR, USD, GBP, CHF). Anything els\u001b[123G r\u001b[126Gturns 422.                  \u001b[155G     \r\u001b[6C\u001b[1"]
[0.001, "o", "B\u001b[38;2;80;200;80m16\u001b[10G+\u001b[38;2;248;248;242m- [\u001b[48;2;4;71;0mx\u001b[48;2;2;40;0m] `GET /groups/{id}`\u001b[36Greturns the Group and its\u001b[62Gc\u001b[64Grrent Members in join order. An unknown id returns 404.                                         \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m17\u001b[10G+\u001b[38;2;248;248;242m- [\u001b[48;2;4;71;0mx\u001b[48;2;2;40;0m] `POST /groups/{id}/members` with `{nam\u001b[56G}` returns 201 with the Member. An unknow\u001b[98G Gr\u001b[102Gup returns 404.                                           \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m18\u001b[10G+\u001b[38;2;248;248;242m- [\u001b[48;2;4;71;0mx\u001b[48;2;2;40;0m] Member\u001b[24Gnames\u001b[30Gmust\u001b[35Gbe\u001b[38G1–50\u001b[43Gcharacters\u001b[54G(otherwise\u001b[65G422)\u001b[70Gand\u001b[74Gunique\u001b[81Gwithin\u001b[88Gthe\u001b[92GGroup,\u001b[99Gignoring\u001b[108Gcase\u001b[113G(409\u001b[118Gif\u001b[121Gtaken).\u001b[129GThe\u001b[133Guniqueness\u001b[144Grule\u001b[149Galso\u001b[154Gapplie\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   +\u001b[38;2;248;248;242ms among the initial Members passed to `POST /groups`.                                                                                                \r\u001b[6C\u001b[1B\u001b[38;2;80;2"]
[0.001, "o", "00;80m19\u001b[10G+\u001b[38;2;248;248;242m- [\u001b[48;2;4;71;0mx\u001b[48;2;2;40;0m] Join order is recorded for each Member,\u001b[57Gready\u001b[63Gfor\u001b[67Gthe\u001b[71GRemainder\u001b[81Grule\u001b[86Gin\u001b[89Glater\u001b[95Gtickets.\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m20 +\u001b[38;2;248;248;242m- \u001b[14G\u001b[48;2;4;71;0mx\u001b[48;2;2;40;0m] All\u001b[21Gtests go through t\u001b[40Ge HTTP test client against a temporary database. No test touches SQL d\u001b[111Grectly.                                          \r\u001b[1B\u001b[49m\u001b[38;2;153;153;153m  ⎿  \u001b[39mUpdated \u001b[1mREADME.md\u001b[22m \u001b[38;2;153;153;153m(+10 -0)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1 +\u001b[38;2;248;248;242m# Expense\u001b[21GSplitter                                                                                                                               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m  2 +\u001b[38;2;248;248;242m                                                                                                                                                     \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  3 +\u001b[38;2;248;248;242mA web "]
