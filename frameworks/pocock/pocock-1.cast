[0.001, "o", "\u001b[38;2;248;248;242m                                                        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 31 +\u001b[38;2;248;248;242m    remaining = {member_id: balance \u001b[38;2;249;38;114mfor\u001b[38;2;248;248;242m member_id, balance \u001b[38;2;249;38;114min\u001b[38;2;248;248;242m balances}                                                                              \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 32 +\u001b[38;2;248;248;242m    rank = {member_id: i \u001b[38;2;249;38;114mfor\u001b[38;2;248;248;242m i, (member_id, _) \u001b[38;2;249;38;114min\u001b[38;2;248;248;242m \u001b[38;2;166;226;46menumerate\u001b[38;2;248;248;242m(balances)}                                                                               \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 33 +\u001b[38;2;248;248;242m    transfers: \u001b[38;2;166;226;46mlist\u001b[38;2;248;248;242m[Transfer] = []                                                                                                                   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 34 +\u001b[38;2;248;248;242m    \u001b[38;2;249;38;114mwhile"]
