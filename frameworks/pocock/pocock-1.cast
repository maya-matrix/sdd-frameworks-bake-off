[0.016, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3Gnow records the Remainder\u001b[29Grule.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BRounds 1 and 2 left a few small points unasked. These are the defaults I'll assume:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDeparted Members can't be used anywhere new.\u001b[50G\u001b[22mThey\u001b[55Gcan't\u001b[61Gbe\u001b[64Gthe\u001b[68GPayer\u001b[74Gor\u001b[77Ga\u001b[79GParticipant\u001b[91Gof\u001b[94Ga\u001b[96Gnew\u001b[100GExpense,\u001b[109Gor\u001b[112Gthe\u001b[116Gsender\u001b[123Gor\u001b[126Grecipient\u001b[136Gof\u001b[139Ga\u001b[141Gnew\u001b[145GPayment.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDeletes that would unsettle a Departed Member return 409.\u001b[63G\u001b[22mThis\u001b[68Gcovers\u001b[75GPayments\u001b[84Gas\u001b[87Gwell\u001b[92Gas\u001b[95GExpenses:\u001b[105Gdeleting\u001b[114Geither\u001b[121Gis\u001b[124Grefused\u001b[132Gif\u001b[135Git\u001b[138Gwould\u001b[144Gmove\u001b[149Ga\u001b[151GDeparted\r\u001b[4C\u001b[1BMember's Balance off 0.\r\u001b[1B  - \u001b[1mA Member can't leave wh\u001b[29Gle their Balance is non\u001b[53Gz\u001b[55Gro\u001b[22m (409).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mErrors:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- 404\u001b[11Gfor\u001b[15Gan\u001b[18Gunknown\u001b[26GGroup,\u001b[33GMember,\u001b[41GExpense\u001b[49Gor\u001b[52GPayment,\u001b[61Gor\u001b[64Gone\u001b[68Gthat\u001b[73Gbelongs\u001b[81Gto\u001b[84Ganother\u001b[92GGroup.\r\u001b[4C\u001b[1"]
[0.001, "o", "B- 422 for bad input, including unknown or departed Member IDs in a request body.\u001b[K\r\u001b[4C\u001b[1B- 409 for name clashes and the rules above.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDuplicate Participant IDs in one Expense return 422\u001b[22m rather than being silently de-duplicated.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat we've agreed\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStack:\u001b[22m Python, FastAPI, pytest, \u001b[38;2;177;185;249muv\u001b[39m, and SQLite through the standard \u001b[38;2;177;185;249msqlite3\u001b[39m module.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNo auth:\u001b[22m Members belong to their Group and are not global users.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMoney:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- Each Group has one 2-decimal ISO currency.\u001b[K\r\u001b[4C\u001b[1B- Amounts are always whole cents, with no floats anywhere.\u001b[K\r\u001b[1B    - Lef\u001b[11Gover cents from an equal\u001b[36Gsplit\u001b[42Ggo\u001b[45Gone\u001b[49Geach\u001b[54Gto\u001b[57GParticipants\u001b[70Gin\u001b[73Gthe\u001b[77Gorder\u001b[83Gthey\u001b[88Gjoined.\r\u001b[4C\u001b[1B- Each Expense's Shares add up exactly to its amount, and each Group's Balances add up to exactly 0.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mExpenses:\u001b[22m\u001b[K\r\u001b[4"]
[0.001, "o", "C\u001b[1B- The Payer doesn't have to be a Participant.\u001b[K\r\u001b[4C\u001b[1B- The description\u001b[23Gis\u001b[26G1–200\u001b[32Gcharacters.\r\u001b[4C\u001b[1B- Expenses can be deleted permanently but not edited.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPayments:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- Can be recorded and deleted.\u001b[K\r\u001b[4C\u001b[1B- Sender and recipient must be different, current Members.\u001b[K\r\u001b[4C\u001b[1B- The amount must be positive; overpaying is allowed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMembers:\u001b[22m\u001b[K\r\u001b[1B    - Names are 1–50 characters and unique\u001b[44Gwithin\u001b[51Gthe\u001b[55GGroup,\u001b[62Gignoring\u001b[71Gcase.\r\u001b[4C\u001b[1B-\u001b[7GA\u001b[9GMember\u001b[16Gcan\u001b[20Gleave\u001b[26Gonly\u001b[31Gonce\u001b[36Gtheir\u001b[42GBalance\u001b[50Gis\u001b[53G0;\u001b[56Gthey're\u001b[64Gkept\u001b[69Gin\u001b[72Ghistory.\r\u001b[1B \u001b[3G  -\u001b[K\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
