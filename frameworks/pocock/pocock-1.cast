[0.041, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1S\u001b[r\u001b[H\u001b[3Gfine. Your call on how \"real\" it needs\u001b[42Gto be.\u001b[K\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.368, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1S\u001b[r\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[34B❓\u001b[6G\u001b[1mQ6\u001b[9G\u001b[22m-\u001b[11G\u001b[1m\"Minimum transfers\"\u001b[22m:\u001b[32GTruly\u001b[38Gminimising\u001b[49Gthe\u001b[53G\u001b[3mnumber\u001b[60G\u001b[23mof\u001b[63Gtransfers\u001b[73Gis\u001b[76GNP-hard\u001b[84G(it\u001b[88Greduces\u001b[96Gto\u001b[99Gfinding\u001b[107Gthe\u001b[111Gmost\u001b[116Gzero-sum\u001b[125Gsubgroups).\u001b[137GThe\u001b[141Gstandard\u001b[150Ggreedy\u001b[157Gapproach\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.015, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1S\u001b[r\u001b[H\u001b[3G---\r\u001b[2C\u001b[34B(repeatedly\u001b[15Gmatch\u001b[21Gthe\u001b[25Glargest\u001b[33Gdebtor\u001b[40Gwith\u001b[45Gthe\u001b[49Glargest\u001b[57Gcreditor)\u001b[67Gis\u001b[70Gguaranteed\u001b[81Gto\u001b[84Guse\u001b[88Gat\u001b[91Gmost\u001b[96Gn−1\u001b[100Gtransfers\u001b[110Gbut\u001b[114Gisn't\u001b[120Galways\u001b[127Goptimal.\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.013, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1S\u001b[r\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[34B-\u001b[5G(a)\u001b[9GGreedy,\u001b[17Gdocumented\u001b[28Gas\u001b[31G\"at\u001b[35Gmost\u001b[40Gn−1\u001b[44Gtransfers\"\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.015, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1S\u001b[r\u001b[H\u001b[3G❓\u001b[6G\u001b[1mQ3\u001b[9G\u001b[22m-\u001b[11G\u001b[1mWho is a \"member\"?\u001b[30G\u001b[22mThe\u001b[34Gbrief\u001b[40Gsays\u001b[45G\"users\u001b[52Gcreate\u001b[59Ggroups\u001b[66Gand\u001b[70Gadd\u001b[74Gmembers\".\u001b[84GIs\u001b[87Ga\u001b[89G\u001b[1mMember\u001b[96G\u001b[22mjust\u001b[101Ga\u001b[103Gname\u001b[108Ginside\u001b[115Gone\u001b[119Ggroup\u001b[125G(\"Alice\"\u001b[134Gin\u001b[137G\"Ski\u001b[142GTrip\"),\u001b[150Gor\u001b[153Ga\u001b[155Greference\u001b[165Gto\r\u001b[2C\u001b[34B-\u001b[5G(b)\u001b[9GExact\u001b[15Gminimum\u001b[23Gvia\u001b[27Gsubset\u001b[34Gsearch,\u001b[42Gpractical\u001b[52Gup\u001b[55Gto\u001b[58Gabout\u001b[64G15–20\u001b[70Gmembers\u001b[78Gwith\u001b[83Gnon-zero\u001b[92Gbalances,\u001b[102Gwith\u001b[107Ggreedy\u001b[114Gas\u001b[117Ga\u001b[119Gfallback\u001b[128Gabove\u001b[134Gthat\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.016, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[2S\u001b[r\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[33B-\u001b[5G(c)\u001b[9GExact\u001b[15Gminimum\u001b[23Gonly,\u001b[29Gwith\u001b[34Ga\u001b[36Ghard\u001b[41Gmember\u001b[48Gcap\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.035, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[2S\u001b[r\u001b[H\u001b[3G-\u001b[5G(a)\u001b[9GMembers\u001b[17Gare\u001b[21Ggroup-scoped\u001b[34Gnames.\u001b[41GNo\u001b[44Gusers,\u001b[51Gno\u001b[54Gauth.\u001b[60GAny\u001b[64Gcaller\u001b[71Gcan\u001b[75Gact\u001b[79Gon\u001b[82Gany\u001b[86Ggroup.\r\u001b[2C\u001b[33B\u001b[4G \u001b[3G➡️\u001b[6G(b).\u001b[11GThe\u001b[15Gbrief\u001b[21Gexplicitly\u001b[32Gsays\u001b[37G\"minimum\",\u001b[48Gso\u001b[51Gwe\u001b[54Gshould\u001b[61Ghonour\u001b[68Git\u001b[71Gfor\u001b[75Grealistic\u001b[85Ggroup\u001b[91Gsizes,\u001b[98Gand\u001b[102Gthe\u001b[106Gfallback\u001b[115Gkeeps\u001b[121Git\u001b[124Gsafe.\u001b[130GThis\u001b[135Gone\u001b[139Gis\u001b[142Gworth\u001b[148Gan\u001b[151GADR.\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.016, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[2S\u001b[r\u001b[H\u001b[6Gc\u001b[9GFull auth (tokens, passwords)\u001b[K\r\u001b[2C\u001b[33B---\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.423, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[2S\u001b[r\u001b[H\u001b[4G \u001b[3G➡️\u001b[5G (b). It\u001b[14Gkeeps \"Us\u001b[24Gr\u001b[26G create groups\"\u001b[42Gand\u001b[46G\"any\u001b[51Gmember\u001b[58Gcan\u001b[62Grecord\"\u001b[70Gmeaningful\u001b[81Gand\u001b[85Gtestable\u001b[94G(non-member\u001b[106Ggets\u001b[111G403)\u001b[116Gwithout\u001b[124Gbuilding\u001b[133Greal\u001b[138Gauth.\r\u001b[2C\u001b[33B❓\u001b[6G\u001b[1mQ7\u001b[9G\u001b[22m-\u001b[11G\u001b[1mRecording settlements\u001b[22m:\u001b[34GIs\u001b[37Gsettle-up\u001b[47Gonly\u001b[52Ga\u001b[54G\u001b[3msuggestion\u001b[23m,\u001b[66Gor\u001b[69Gcan\u001b[73Gmembers\u001b[81Galso\u001b[86Grecord\u001b[93Ga\u001b[95G\u001b[1mPayment\u001b[103G\u001b[22m(\"Bob\u001b[109Gpaid\u001b[114GAlice\u001b[120G€12\")\u001b[126Gthat\u001b[131Gmoves\u001b[137Gbalances?\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.537, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[4S\u001b[r\u001b[H\u001b[3G❓\u001b[6G\u001b[1mQ4\u001b[22m -\u001b[11G\u001b[1mCurrency\u001b[22m: On\u001b[24G cur\u001b[30Gncy\u001b[34Gper group, a global single currency, or multi-currency exp\u001b[93Gnses?\u001b[K\r\u001b[2C\u001b[31B\u001b[4G \u001b[3G➡️\u001b[6GYes,\u001b[11Gsupport\u001b[19Grecording\u001b[29Ga\u001b[31GPayment.\u001b[40GWithout\u001b[48Gone,\u001b[53Gbalances\u001b[62Gcan\u001b[66Gnever\u001b[72Ggo\u001b[75Gback\u001b[80Gto\u001b[83Gzero\u001b[88Gin\u001b[91Gthe\u001b[95Gapp,\u001b[100Gand\u001b[104Gsettle-up\u001b[114Gwould\u001b[120Gbe\u001b[123Gsuggesting\u001b[134Gthe\u001b[138Gsame\u001b[143Gtransfers\u001b[153Gforever.\r\u001b[2C\u001b[2B---\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.387, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[3S\u001b[r\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[32B❓\u001b[6G\u001b[1mQ8\u001b[9G\u001b[22m-\u001b[11G\u001b[1mMutability and history\u001b[22m:\u001b[35GWhich\u001b[41Gof\u001b[44Gthese\u001b[50Gshould\u001b[57Gbe\u001b[60Gpossible?\r\u001b[2C\u001b[2B-\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.141, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[2S\u001b[r\u001b[H\r\u001b[4C\u001b[32BEdit\u001b[10Gan\u001b[13Gexpense\r\u001b[2C\u001b[1B-\u001b[5GDelete\u001b[12Gan\u001b[15Gexpense\r\u001b[2C\u001b[1B-\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.358, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1S\u001b[r\u001b[H\u001b[3G❓\u001b[6G\u001b[1mQ5\u001b[9G\u001b[22m-\u001b[11G\u001b[1mIndivisible remainders (the key exactness question)\u001b[22m:\u001b[64G€10.00\u001b[71Gsplit\u001b[77Gequally\u001b[85Gamong\u001b[91G3\u001b[93Gpeople\u001b[100Gis\u001b[103G333.33…\u001b[111Gcents.\u001b[118G\"Exact,\u001b[126Gno\u001b[129Grounding\u001b[138Gerrors\"\u001b[146Gcan\u001b[150Gmean\u001b[155Gtwo\r\u001b[4C\u001b[33BRemove\u001b[12Ga\u001b[14Gmember\u001b[21Gfrom\u001b[26Ga\u001b[28Ggroup\u001b[34G(what\u001b[40Ghappens\u001b[48Gif\u001b[51Gtheir\u001b[57Gbalance\u001b[65Gisn't\u001b[71Gzero,\u001b[77Gor\u001b[80Gthey\u001b[85Gappear\u001b[92Gin\u001b[95Gpast\u001b[100Gexpenses?)\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.715, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1S\u001b[r\u001b[H\u001b[3Gdifferent things:\u001b[K\r\u001b[2C\u001b[34B\u001b[4G \u001b[3G➡️\u001b[6GExpenses\u001b[15G(and\u001b[20GPayments)\u001b[30Gcan\u001b[34Gbe\u001b[37G\u001b[1mdeleted\u001b[45G\u001b[22mbut\u001b[49Gnot\u001b[53Gedited,\u001b[61Gsince\u001b[67Gdelete-and-re-record\u001b[88Gis\u001b[91Genough.\u001b[99GMembers\u001b[107G\u001b[1mcan't be removed\u001b[124G\u001b[22min\u001b[127Gv1.\u001b[131GThat\u001b[136Gavoids\u001b[143Gthe\u001b[147G\"removed\u001b[156Gmember\u001b[163Gwith\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.526, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[4S\u001b[r\u001b[H\u001b[3G  at some\u001b[13Gpo\u001b[17Gt anyway.\r\u001b[2C\u001b[31Bdebts\"\u001b[10Gproblem\u001b[18Gcompletely.\u001b[30GThe\u001b[34Galternative\u001b[46Gis\u001b[49Gto\u001b[52Gallow\u001b[58Gremoval\u001b[66Gonly\u001b[71Gwhen\u001b[76Gthe\u001b[80Gmember's\u001b[89Gbalance\u001b[97Gis\u001b[100Gexactly\u001b[108G0\u001b[110Gand\u001b[114Gthey're\u001b[122Gnot\u001b[126Gin\u001b[129Gany\u001b[133Gexpense.\r\u001b[2C\u001b[2B---\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.336, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[3S\u001b[r\u001b[H\u001b[3GSub-question: should the\u001b[28Gleftover\u001b[37Gcent\u001b[42Ggo\u001b[45Gto\u001b[48Gthe\u001b[52Gfirst\u001b[58Gparticipants\u001b[71Gin\u001b[74Ga\u001b[76Gstable\u001b[83Gorder,\u001b[90Gor\u001b[93Gshould\u001b[100Gthe\u001b[104G\u001b[1mpayer\u001b[110G\u001b[22mabsorb\u001b[117Git\u001b[120Gwhen\u001b[125Gthey're\u001b[133Ga\u001b[135Gparticipant?\u001b[148GI\u001b[150Grecommend\u001b[160Ga\r\u001b[2C\u001b[32B❓\u001b[6G\u001b[1mQ9\u001b[9G\u001b[22m-\u001b[11G\u001b[1mExpense validation rules\u001b[22m:\u001b[37GDo\u001b[40Gyou\u001b[44Gagree\u001b[50Gwith\u001b[55Gthese?\r\u001b[2C\u001b[2B-\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.190, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1S\u001b[r\u001b[H\u001b[3Gstable order by member ID, because it's simple and predictable.\u001b[K\r\u001b[4C\u001b[33BThe\u001b[9Gpayer\u001b[15Gmust\u001b[20Gbe\u001b[23Ga\u001b[25Gmember\u001b[32Gof\u001b[35Gthe\u001b[39Ggroup.\r\u001b[2C\u001b[1B-\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.332, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1S\u001b[r\u001b[H\u001b[3G\u001b[K\r\u001b[4C\u001b[33BThe\u001b[9Gparticipants\u001b[22G(whoever\u001b[31Gthe\u001b[35Gexpense\u001b[43Gis\u001b[46Gsplit\u001b[52Gbetween)\u001b[61Gmust\u001b[66Gbe\u001b[69Ga\u001b[71Gnon-empty\u001b[81Gset\u001b[85Gof\u001b[88Gdistinct\u001b[97Ggroup\u001b[103Gmembers.\r\u001b[2C\u001b[1B-\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.195, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1S\u001b[r\u001b[H\u001b[3G---\r\u001b[4C\u001b[33BThe\u001b[9Gpayer\u001b[15Gdoes\u001b[20G\u001b[1mnot\u001b[24G\u001b[22mhave\u001b[29Gto\u001b[32Gbe\u001b[35Ga\u001b[37Gparticipant\u001b[49G(e.g.\u001b[55GAlice\u001b[61Gpays\u001b[66Gfor\u001b[70GBob\u001b[74Gand\u001b[78GCarol's\u001b[86Gtickets).\r\u001b[2C\u001b[1B-\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
