[0.066, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[22S\u001b[r\u001b[H\u001b[3G \u001b[5G- Returns an \u001b[38;2;177;185;249moptimal\u001b[39m flag and a\u001b[37Gdeterminist\u001b[49Gc list of transfers.\u001b[K\r\u001b[9B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mBefore\u001b[10GI\u001b[12Gwrite\u001b[18Gthe\u001b[22Gspec,\u001b[28Gtwo\u001b[32Gthings\u001b[39Gneed\u001b[44Gyour\u001b[49Ginput.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m1. There's no issue tracker set up.\u001b[39G\u001b[22mThe\u001b[43Grepo\u001b[48Ghas\u001b[52Gno\u001b[55Ggit\u001b[59Gremote\u001b[66Gand\u001b[70Gno\u001b[73Gtracker\u001b[81Gor\u001b[84Gtriage-label\u001b[97Gconfiguration.\u001b[112GThe\u001b[116Gskill\u001b[122Gsays\u001b[127Gto\u001b[130Grun\u001b[134G\u001b[38;2;177;185;249m/setup-matt-pocock-skills\u001b[160G\u001b[39mfirst,\r\u001b[2C\u001b[1Bbut\u001b[7Gthat\u001b[12Gskill\u001b[18Gisn't\u001b[24Gin\u001b[27Gthis\u001b[32Gsession's\u001b[42Ginstalled\u001b[52Glist.\u001b[58GPick\u001b[63Gone:\r\u001b[2C\u001b[1B-\u001b[5G(a)\u001b[9GWrite\u001b[15Gthe\u001b[19Gspec\u001b[24Gas\u001b[27Ga\u001b[29Glocal\u001b[35GMarkdown\u001b[44Gfile,\u001b[50G\u001b[38;2;177;185;249mdocs/specs/0001-expense-splitting-api.md\u001b[39m.\u001b[92G\u001b[38;2;177;185;249m/to-tickets\u001b[104G\u001b[39mcan\u001b[108Gthen\u001b[113Gwork\u001b[118Gfrom\u001b[123Git.\u001b[127G\u001b[1m(Recommended)\r\u001b[2C"]
[0.002, "o", "\u001b[1B\u001b[22m-\u001b[5G(b)\u001b[9GStop\u001b[14Ghere\u001b[19Gso\u001b[22Gyou\u001b[26Gcan\u001b[30Gset\u001b[34Gup\u001b[37Ga\u001b[39Gtracker\u001b[47G(for\u001b[52Gexample,\u001b[61Ga\u001b[63GGitHub\u001b[70Grepo\u001b[75Gand\u001b[79G\u001b[38;2;177;185;249mgh\u001b[39m)\u001b[83Gand\u001b[87Grun\u001b[91Gthe\u001b[95Gsetup\u001b[101Gskill.\r\u001b[2C\u001b[2B\u001b[1m2. Test seams.\u001b[18G\u001b[22mI\u001b[20Gsuggest\u001b[28Gthese:\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPrimary seam: the HTTP API.\u001b[33G\u001b[22mTests\u001b[39Gcall\u001b[44Gthe\u001b[48GFastAPI\u001b[56Gapp\u001b[60Gin-process\u001b[71Gthrough\u001b[79GFastAPI's\u001b[89Gtest\u001b[94Gclient,\u001b[102Gwith\u001b[107Ga\u001b[109Gfresh\u001b[115Gtemporary\u001b[125GSQLite\u001b[132Gdatabase\u001b[141Gfor\u001b[145Geach\u001b[150Gtest.\u001b[156GThis\u001b[161Gseam\r\u001b[4C\u001b[1Bwould\u001b[11Gcover\u001b[17Gnearly\u001b[24Geverything:\u001b[36Gvalidation,\u001b[48G404/409/422\u001b[60Gresponses,\u001b[71Ghow\u001b[75Gleftover\u001b[84Gcents\u001b[90Gare\u001b[94Gshared\u001b[101Gout,\u001b[106GBalances\u001b[115Gadding\u001b[122Gto\u001b[125Gzero,\u001b[131Gdeparted-Member\u001b[147Grules,\u001b[154Gdeletes,\u001b[163Gand\r\u001b[4C\u001b[1BSettle-up\u001b[15Goutput.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSecondary seam: the Settle-up algorithm as a pure function.\u001b[65G\u001b[22mIt\u001b[68Gtakes\u001b[74Ga\u001b[76Gmap\u001b[80Gof\u001b[83GBalances\u001b[92Gand\u001b[96Greturns\u001b[104Gthe\u001b[108GSugg"]
