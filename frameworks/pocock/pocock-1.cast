[0.003, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mWhat it delivers:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mGET /groups/{id}/settle-up\u001b[34G\u001b[39mreturns\u001b[42G\u001b[38;2;177;185;249m{transfers, optimal}\u001b[39m,\u001b[64Gwith\u001b[69Gan\u001b[72Gempty\u001b[78Glist\u001b[83Gwhen\u001b[88Geveryone\u001b[97Gis\u001b[100Gsettled.\r\u001b[2C\u001b[1B  - End-to-end test: recording\u001b[34Gevery\u001b[40GSuggested\u001b[50GTransfer\u001b[59Gas\u001b[62Ga\u001b[64GPayment\u001b[72Gbrings\u001b[79Gall\u001b[83GBalances\u001b[92Gto\u001b[95Gzero.\r\u001b[2C\u001b[1B \u001b[5G- A test with more\u001b[24Gthan\u001b[29G16\u001b[32GMembers\u001b[40Gchecks\u001b[47Gthe\u001b[51Ggreedy\u001b[58Gfallback\u001b[67Gand\u001b[71G\u001b[38;2;177;185;249moptimal: false\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m7. Delete Expenses and Payments\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBlocked by:\u001b[22m 5\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat it delivers:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mDELETE\u001b[14G\u001b[39mfor\u001b[18GExpenses\u001b[27Gand\u001b[31GPayments\u001b[40Greturns\u001b[48G204,\u001b[53Gand\u001b[57GBalances\u001b[66Gupdate\u001b[73Gto\u001b[76Gmatch.\r\u001b[2C\u001b[1B  - 404 for an unknown Expense or\u001b[37GPayment,\u001b[46Gor\u001b[49Gone\u001b[53Gfrom\u001b[58Ganother\u001b[66GGroup.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m8. Member\u001b[15Gparture\r\u001b[2C\u001b[1B"]
[0.002, "o", "\u001b[22m-\u001b[5G\u001b[1mBlocked by:\u001b[22m 5, 7\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat it delivers:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mDELETE /groups/{id}/members/{mid}\u001b[41G\u001b[39mreturns\u001b[49G409\u001b[53Gunless\u001b[60Gthe\u001b[64GMember's\u001b[73GBalance\u001b[81Gis 0.\r\u001b[2C\u001b[1B  - A Departed Member\u001b[25Gstill\u001b[31Gshows\u001b[37Gon\u001b[40Gpast\u001b[45GExpenses\u001b[54Gand\u001b[58GPayments.\r\u001b[2C\u001b[1B \u001b[5G- A Departed Member\u001b[25Gis\u001b[28Gexcluded\u001b[37Gfrom\u001b[42Gthe\u001b[46GGroup's\u001b[54GMember\u001b[61Glist,\u001b[67GBalances\u001b[76Gand\u001b[80GSettle-up,\u001b[91Gand\u001b[95Gcan't\u001b[101Gbe\u001b[104Gused\u001b[109Gin\u001b[112Gnew\u001b[116GExpenses\u001b[125Gor\u001b[128GPayments\u001b[137G(422).\r\u001b[2C\u001b[1B \u001b[5G- Their name stays\u001b[24Greserved.\r\u001b[6C\u001b[1BDeleting an Expense or Payment returns 409 if\u001b[53Git would leave a Departed Member with\u001b[91Ga\u001b[93Gnon-zero\u001b[102GBalance.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOrder of work:\u001b[18G\u001b[22m1 and 2 can start st\u001b[39Gaight away. Then 3 → 4 → 5\u001b[67Gafter which 6 and 7 can\u001b[91Grun\u001b[95Gin parallel. 8 com\u001b[114Gs\u001b[116Glast.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mQuestions\u001b[22m\u001b[K\r\u001b[2C\u001b[2B1. \u001b[1mG\u001b[8Ganularity:\u001b[22m Is this too fine? "]
[0.001, "o", "Tickets\u001b[45G4 \u001b[48Gnd\u001b[51G5 could merge into a single\u001b[79G\"B\u001b[82Glances and Payments\" ticket. Is it too coarse?\u001b[129GTicket\u001b[136G8\u001b[138Gcould\u001b[144Gsplit\u001b[150Ginto\u001b[155G\"leave\u001b[162Gthe\r\u001b[5C\u001b[1BGroup\"\u001b[13Gand\u001b[17G\"protect\u001b[26Gdeletes\".\r\u001b[2C\u001b[1B2. \u001b[1mBlocking edges:\u001b[22G\u001b[22m6\u001b[24Gwaits\u001b[30Gfor\u001b[34G5\u001b[36Gonly\u001b[41Gbecause\u001b[49Gof\u001b[52Gthe\u001b[56Gend-to-end\u001b[67G\"settle\u001b[75Gby\u001b[78Grecording\u001b[88GPayments\"\u001b[98Gtest.\u001b[104GWithout\u001b[112Gthat\u001b[117Gtest,\u001b[123G6\u001b[125Gcould\u001b[131Gstart\u001b[137Gright\u001b[143Gafter\u001b[149G2\u001b[151Gand 4.\u001b[158GI'd\u001b[162Gkeep\r\u001b[5C\u001b[1Bthe\u001b[10Gdependency\u001b[21Gon 5.\r\u001b[2C\u001b[1B3\u001b[6GShould any ticke\u001b[23Gs be merged or spli\u001b[43G?\u001b[45G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 20s · done 8:31 PM\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;80;80;80m❯ \u001b[38;2;153;153;153m/implement\u001b[39m                                                                                                                                                          \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m✻\u001b[3GGesticulatin\u001b[38;2;235;159;127"]
