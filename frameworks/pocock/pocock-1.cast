[1.690, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G❓\u001b[6G\u001b[1mQ7\u001b[9G\u001b[22m-\u001b[11G\u001b[1mRecording settlements\u001b[22m:\u001b[34GIs\u001b[37Gsettle-up\u001b[47Gonly\u001b[52Ga\u001b[54G\u001b[3msuggestion\u001b[23m,\u001b[66Gor\u001b[69Gcan\u001b[73Gmembers\u001b[81Galso\u001b[86Grecord\u001b[93Ga\u001b[95G\u001b[1mPayment\u001b[103G\u001b[22m(\"Bob\u001b[109Gpaid\u001b[114GAlice\u001b[120G€12\")\u001b[126Gthat\u001b[131Gmoves\u001b[137Gbalances?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[4G \u001b[3G➡️\u001b[6GYes,\u001b[11Gsupport\u001b[19Grecording\u001b[29Ga\u001b[31GPayment.\u001b[40GWithout\u001b[48Gone,\u001b[53Gbalances\u001b[62Gcan\u001b[66Gnever\u001b[72Ggo\u001b[75Gback\u001b[80Gto\u001b[83Gzero\u001b[88Gin\u001b[91Gthe\u001b[95Gapp,\u001b[100Gand\u001b[104Gsettle-up\u001b[114Gwould\u001b[120Gbe\u001b[123Gsuggesting\u001b[134Gthe\u001b[138Gsame\u001b[143Gtransfers\u001b[153Gforever.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B---\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B❓\u001b[6G\u001b[1mQ8\u001b[9G\u001b[22m-\u001b[11G\u001b[1mMutability and history\u001b[22m:\u001b[35GWhich\u001b[41Gof\u001b[44Gthese\u001b[50Gshould\u001b[57Gbe\u001b[60Gpossible?\r\u001b[2C\u001b[1B- Edit an expense\u001b[K\r\u001b[4C\u001b[1BDelete an expense\r\u001b[4C\u001b[1BR\u001b[7Gmov\u001b[13G m\u001b[16Gmb\u001b[19Gr from\u001b[26Ga\u001b[28Ggroup\u001b[34G(what\u001b[40Ghappens\u001b[48Gif\u001b[51Gtheir\u001b[57Gbalance\u001b[65Gisn't\u001b[71Gzero,\u001b[77Gor\u001b[80Gthey\u001b[85Gappear\u001b[92Gin\u001b[95Gpast\u001b[100Gexpenses?)\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C"]
[0.001, "o", "\u001b[1B\u001b[4G \u001b[3G➡️\u001b[6GExpenses\u001b[15G(and\u001b[20GPayments)\u001b[30Gcan\u001b[34Gbe\u001b[37G\u001b[1mdeleted\u001b[45G\u001b[22mbut\u001b[49Gnot\u001b[53Gedited,\u001b[61Gsince\u001b[67Gdelete-and-re-record\u001b[88Gis\u001b[91Genough.\u001b[99GMembers\u001b[107G\u001b[1mcan't be removed\u001b[124G\u001b[22min\u001b[127Gv1.\u001b[131GThat\u001b[136Gavoids\u001b[143Gthe\u001b[147G\"removed\u001b[156Gmember\u001b[163Gwith\r\u001b[2C\u001b[1Bdebts\" problem completely.\u001b[30GThe\u001b[34Galternative is\u001b[49Gt\u001b[51G allow removal only when the membe\u001b[86G's balance is \u001b[101Gxactly 0 and they're not in any expense.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B---\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B❓\u001b[6G\u001b[1mQ9\u001b[9G\u001b[22m-\u001b[11G\u001b[1mExpense validation rules\u001b[22m:\u001b[37GDo\u001b[40Gyou\u001b[44Gagree\u001b[50Gwith\u001b[55Gthese?\r\u001b[2C\u001b[1B- The\u001b[9Gpayer must be a member of the gr\u001b[43Gp.\u001b[K\r\u001b[10C\u001b[1Brticipants (who\u001b[27Gver the\u001b[35Gexpense is\u001b[46Gsplit\u001b[52Gbetween)\u001b[61Gmust\u001b[66Gbe\u001b[69Ga\u001b[71Gnon-empty\u001b[81Gset\u001b[85Gof\u001b[88Gdistinct\u001b[97Ggroup\u001b[103Gmembers.\r\u001b[10C\u001b[1Byer does \u001b[1mnot\u001b[22m \u001b[25Gave to b\u001b[35Ga \u001b[38Gartic\u001b[44Gpant (e.g. Alice\u001b[61Gpays\u001b[66Gfor Bob and Carol's ticke\u001b[92Gs).\u001b[K\r\u001b[4C\u001b[1BAmount must be\u001b[20Ga positive int"]
