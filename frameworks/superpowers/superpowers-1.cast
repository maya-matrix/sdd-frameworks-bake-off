[0.002, "o", "\u001b[6C\u001b[1BMember(id, group_id, \u001b[29Game)\u001b[39m;\u001b[35Gnames\u001b[41Gare\u001b[45Gunique\u001b[52Gwithin\u001b[59Ga\u001b[61Ggroup.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mExpense(id, group_id, payer_id, amount_cents, description, created_at)\r\u001b[13C\u001b[1BShare(expense_id, member_id, shar\u001b[48G_cents)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mShares are calculated once\u001b[22m, when an expense is recorded,\u001b[62Gand\u001b[66Gsaved.\u001b[73GBalances\u001b[82Gare\u001b[86Gthen\u001b[91Gjust\u001b[96Gsums:\u001b[102G\u001b[38;2;177;185;249mbalance = paid − owed\u001b[39m.\u001b[125GThis\u001b[130Galso\u001b[135Gsets\u001b[140Gup\u001b[143Gunequal\u001b[151Gsplits\u001b[158Glater,\r\u001b[2C\u001b[1B \u001b[5Gbecause only the way shares\u001b[33Gar\u001b[36G produced will change.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mmoney\u001b[39m, \u001b[38;2;177;185;249msplitting\u001b[22G\u001b[39mand\u001b[26G\u001b[38;2;177;185;249msettlement\u001b[37G\u001b[39ma\u001b[39Ge pure\u001b[46Gfunctions with\u001b[61Gno\u001b[64Gdatabase\u001b[73Gaccess,\u001b[81Gso\u001b[84Gthey\u001b[89Gcan\u001b[93Gbe\u001b[96Gtested\u001b[103Gon\u001b[106Gtheir\u001b[112Gown.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDoes\u001b[8Gthis\u001b[13Gsection\u001b[21Glook\u001b[26Gright?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 12s · done 3:38 PM\u001b[71G\u001b"]
