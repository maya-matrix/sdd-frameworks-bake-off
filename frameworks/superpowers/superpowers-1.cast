[0.001, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G  \u001b[6GAPI never hangs.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mGreedy: repeatedly match the largest debtor with the largest creditor.\u001b[22m It's simple and runs in O(n log\u001b[109Gn), but it doesn't\u001b[128Galways\u001b[135Gfind\u001b[140Gthe\u001b[144Gminimum.\u001b[153GFor\u001b[157Gexample,\r\u001b[2C\u001b[1B  \u001b[6Gwith balances +5, +5, −3, −3, −4 it can take 4 transfers when 3 is possible. That breaks the\u001b[99G\"minimum\" requirement.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mGreedy with a pre-pass that matches equal and opposite balances first.\u001b[77G\u001b[22mCloser\u001b[84Gto\u001b[87Gthe\u001b[91Gminimum\u001b[99Gin\u001b[102Gpractice,\u001b[112Gbut\u001b[116Gthere's\u001b[124Gstill\u001b[130Gno\u001b[133Gguarantee.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Grecommend\u001b[15G\u001b[1moption 1\u001b[22m,\u001b[25Gbecause\u001b[33Git\u001b[36Gactually\u001b[45Gmeets\u001b[51G\"minimum\"\u001b[61Gand\u001b[65Git's\u001b[70Ghonest\u001b[77Gabout\u001b[83Gthe\u001b[87Gfallback.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B---\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDesign, section 1: architecture and data model\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mapp/\u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mmoney.py    \u001b[21Gparse \"12.34\" \u001b[37G 1234, format 12"]
