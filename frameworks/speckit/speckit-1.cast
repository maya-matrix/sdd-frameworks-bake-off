[0.002, "o", "\u001b[36mInitialize Specify Project\u001b[0m\r\n\u001b[38;5;244m├── \u001b[0m\u001b[32m●\u001b[0m \u001b[37mCheck required tools\u001b[0m \u001b[90m(ok)\u001b[0m\r\n\u001b[38;5;244m├── \u001b[0m\u001b[32m●\u001b[0m \u001b[37mSelect coding agent integration\u001b[0m \u001b[90m(claude)\u001b[0m\r\n\u001b[38;5;244m├── \u001b[0m\u001b[32m●\u001b[0m \u001b[37mSelect script type\u001b[0m \u001b[90m(sh)\u001b[0m\r\n\u001b[38;5;244m├── \u001b[0m\u001b[2;32m○\u001b[0m \u001b[90mInstall integration\u001b[0m\r\n\u001b[38;5;244m├── \u001b[0m\u001b[2;32m○\u001b[0m \u001b[90mInstall shared infrastructure\u001b[0m\r\n\u001b[38;5;244m├── \u001b[0m\u001b[2;32m○\u001b[0m \u001b[90mEnsure scripts executable\u001b[0m\r\n\u001b[38;5;244m├── \u001b[0m\u001b[2;32m○\u001b[0m \u001b[90mConstitution setup\u001b[0m\r\n\u001b[38;5;244m├── \u001b[0m\u001b[2;32m○\u001b[0m \u001b[90mInstall bundled workflow\u001b[0m\r\n\u001b[38;5;244m└── \u001b[0m\u001b[2;32m○\u001b[0m \u001b[90mFinalize\u001b[0m"]
