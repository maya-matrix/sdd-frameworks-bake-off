[0.001, "o", "1B\u001b[1mWhat's there:\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[1mndpoints:\u001b[22m create and read groups,\u001b[40Gadd members, record and list \u001b[70Gxpenses, net balances per m\u001b[98Gmber, and settle-up.\u001b[119G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mExact money:\u001b[22m a\u001b[20Gl amounts\u001b[30Gare whole cen\u001b[44Gs internally. The\u001b[62GAPI accepts and\u001b[78Greturns\u001b[86Gstrings\u001b[94Glike\u001b[99G\u001b[38;2;177;185;249m\"10.50\"\u001b[107G\u001b[39mand\u001b[111Grejects\u001b[119Gplain\u001b[125GJSON\u001b[130Gnumbers.\u001b[139GLeftover\u001b[148Gcents\u001b[154Ggo\u001b[157Gto\u001b[160Gthe\r\u001b[2C\u001b[1B \u001b[5Gfirst members listed, so\u001b[30G€10.00 \u001b[38Gplit three ways is\u001b[57G3.34 / 3.33 / 3.33.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mStorage:\u001b[22m SQLite, so data survives a restart. A test confirms th\u001b[69Gs,\u001b[72Gand\u001b[76GI checked that the\u001b[95Gtest fails if the\u001b[113Gsecond\u001b[120Gapp\u001b[124Ginstance\u001b[133Gopens\u001b[139Ga\u001b[141Gdifferent\u001b[151Gdatabase\u001b[160Gfile.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mErrors:\u001b[13G\u001b[22mevery\u001b[19Gfailure\u001b[27Greturns\u001b[35G\u001b[38;2;177;185;249m{\"error\": {\"code\", \"message\"}}\u001b[39m,\u001b[67Gwith\u001b[72Gthe\u001b[76GHTTP\u001b[81Gstatus\u001b[88Gchosen\u001b[95Gas\u001b[98Gyou\u001b[102Gapproved.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B"]
[0.001, "o", "\u001b[1mTests (133 total):\u001b[22m\u001b[K\r\u001b[4C\u001b[1BUnit tests\u001b[16Gfor money, splitting, balances and settle-up.\u001b[K\r\u001b[4C\u001b[1BRandomized tes\u001b[20Gs showing that shares\u001b[42Galways add up to the expense, balances\u001b[81Galways\u001b[88Gadd\u001b[92Gup\u001b[95Gto\u001b[98Gzero,\u001b[104Gand\u001b[108Gthe\u001b[112Gsettle-up\u001b[122Gtransfer\u001b[131Gcount\u001b[137Gmatches\u001b[145Ga\u001b[147Gbrute-force\u001b[159Gminimum.\r\u001b[5C\u001b[1Bests through the\u001b[23GHTTP\u001b[28GAPI\u001b[32Gfor\u001b[36Gevery\u001b[42Gendpoint,\u001b[52Gincluding\u001b[62Geach\u001b[67Gerror\u001b[73Gcase.\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Grestart\u001b[17Gtest.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings\u001b[10Gto look\u001b[18Gat:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mYou haven't reviewed the settle-up algorithm yet.\u001b[56G\u001b[22mThe\u001b[60Gplan\u001b[65Ghad\u001b[69Ga\u001b[71Gstop\u001b[76Gafter\u001b[82GTask\u001b[87G3\u001b[89Gfor\u001b[93Gyou\u001b[97Gto\u001b[100Greview\u001b[107Git,\u001b[111Gbut\u001b[115G\u001b[38;2;177;185;249m/build auto\u001b[127G\u001b[39mruns\u001b[132Gwithout\u001b[140Gstopping,\u001b[150Gso\u001b[153GI\u001b[155Gmarked\u001b[162Gthat\r\u001b[5C\u001b[1Brevi\u001b[11Gw as deferred in \u001b[38;2;177;185;249mtasks/todo.md\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GThe algorithm\u001b[22Gdiffers from\u001b[35Gwhat the plan described. The pla"]
