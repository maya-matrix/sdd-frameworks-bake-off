[0.079, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1T\u001b[r\u001b[H\u001b[6G\u001b[38;2;248;248;242m\u001b[2m    \u001b[22meger cents**.\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +174 lines \r\u001b[70C\u001b[33B\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (click) ↓ \u001b[39m\u001b[49m\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.554, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1T\u001b[r\u001b[H\u001b[7G\u001b[38;2;248;248;242m\u001b[2m10\u001b[10G\u001b[22m4. **Mo\u001b[18Gey travels as decimal strings** in JSON (`\"10.00\"`), never JSON numbers, so clients can't introduce float error. Internally all money is **int\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22meger cents**.\r\u001b[70C\u001b[33B\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (click) ↓ \u001b[39m\u001b[49m\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.058, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1T\u001b[r\u001b[H\u001b[7G\u001b[38;2;248;248;242m\u001b[2m 9\u001b[10G\u001b[22m3\u001b[15GOne cur\u001b[23Gency per\u001b[32Ggroup, 2 decimal places**\u001b[59Ge.g. EUR). No cu\u001b[76Grency\u001b[82Gconv\u001b[89Gion.\u001b[94GCurrency code\u001b[109Gs stored\u001b[119Gor display only; default `EUR`.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 10 \u001b[22m4. **Money travels as decimal strings** in JSON (`\"10.00\"`), never JSON numbers, so clients can't introduce float error. Internally all money is **int\r\u001b[70C\u001b[33B\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (click) ↓ \u001b[39m\u001b[49m\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.074, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1T\u001b[r\u001b[H\u001b[8G\u001b[38;2;248;248;242m\u001b[2m \u001b[10G\u001b[22m caller identity is not verifie\u001b[42G.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  9 \u001b[22m3. **One currency per group, 2 decimal places** (e.g. EUR). No currency conversion. Currency code is stored for display only; default `EUR`.\r\u001b[70C\u001b[33B\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (click) ↓ \u001b[39m\u001b[49m\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
