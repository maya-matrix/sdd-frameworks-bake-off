[0.001, "o", "s \u001b[38;2;177;185;249m72f6fba\u001b[39m. On a 20-member group where everyone h\u001b[99Gs a non-zero\u001b[112Gbalance,\u001b[121Gthe\u001b[125Gfirst\u001b[131Gsettle-up\u001b[141Grequest\u001b[149Gtakes\u001b[155G152\u001b[159Gms\u001b[162Gand\r\u001b[2C\u001b[1Brepeat\u001b[10Grequests\u001b[19Gtake\u001b[24Gabout\u001b[30G1\u001b[32Gms.\u001b[36GAll\u001b[40G142\u001b[44Gtests\u001b[50Gpass,\u001b[56Gcoverage\u001b[65Gis\u001b[68Gstill\u001b[74G100%,\u001b[80Gand\u001b[84Gmypy\u001b[89Gand\u001b[93Gruff\u001b[98Gare\u001b[102Gclean.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it works:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GS\u001b[7Gttle-up results ar\u001b[26G cached\u001b[34Gi\u001b[36G memory, keyed\u001b[51Gby\u001b[54Gthe\u001b[58Ggroup's\u001b[66Gexact\u001b[72Gbalances\u001b[81G(each\u001b[87Gmember\u001b[94GID\u001b[97Gwith\u001b[102Gtheir\u001b[108Gbalance\u001b[116Gin\u001b[119Gcents).\u001b[127GIn\u001b[130Gpractice\u001b[139Gthat's\u001b[146Gone\u001b[150Gentry\u001b[156Gper\u001b[160Ggroup,\r\u001b[2C\u001b[1B \u001b[5Gbecause memb\u001b[18Gr ID\u001b[24Gbe\u001b[27Gong to \u001b[35Gnly one group.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Ganswer dep\u001b[20Gnds only\u001b[29Gon\u001b[32Gthose\u001b[38Gbalances.\u001b[48GSo\u001b[51Gwhen\u001b[56Ga\u001b[58Gnew\u001b[62Gexpense\u001b[70Gor\u001b[73Gmember\u001b[80Gchanges\u001b[88Gthem,\u001b[94Gthe\u001b[98Gnext\u001b[103Grequest\u001b[111Gmisses\u001b[118Gthe\u001b[122Gcache\u001b[128Gand\u001b[132Grecomput"]
[0.001, "o", "es,\u001b[144Gand\u001b[148Gan\u001b[151Goutdated\u001b[160Gresult\r\u001b[2C\u001b[1B \u001b[5Gcan never be returned.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNothing needs c\u001b[21Geari\u001b[26Gg when data changes,\u001b[47Gand\u001b[51Gthe\u001b[55Gdatabase\u001b[64Gschema\u001b[71Gdidn't\u001b[78Gchange.\u001b[86GEach\u001b[91Grequest\u001b[99Gstill\u001b[105Greads\u001b[111Gthe\u001b[115Gbalances\u001b[124Gfrom\u001b[129Gthe\u001b[133Gdatabase,\u001b[143Gwhich\u001b[149Gis\u001b[152Gcheap;\u001b[159Gonly\u001b[164Gthe\r\u001b[2C\u001b[1B \u001b[5Gexpensiv\u001b[15Gca\u001b[18Gculation\u001b[27Gis skipped.\u001b[K\r\u001b[4C\u001b[1BThe cache holds up to 1,024 groups and drops\u001b[54Gleast\u001b[60Grecently used beyond that.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gadded\u001b[13Gthis\u001b[18Grule\u001b[23Gto\u001b[26Gthe\u001b[30Gspec\u001b[35Gbefore\u001b[42Gwriting\u001b[50Gthe\u001b[54Gcode.\u001b[60GThe\u001b[64GREADME\u001b[71Gand\u001b[75G\u001b[38;2;177;185;249mtasks/todo.md\u001b[89G\u001b[39mare\u001b[93Gupdated\u001b[101Gtoo.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests added:\u001b[22m\u001b[K\r\u001b[5C\u001b[1B r\u001b[9Gpe\u001b[12Gt\u001b[14Greque\u001b[20Gt\u001b[22Gfor an unchanged group is served from\u001b[60Gthe cache, a\u001b[73Gd the result matches the uncached calcula\u001b[115Gion.\u001b[120G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAfter\u001b[11Gan\u001b[14Gexpense\u001b[22Gis\u001b[25Gadded\u001b[31Gto\u001b[34Ga\u001b[36Gcached\u001b[43Ggro"]
