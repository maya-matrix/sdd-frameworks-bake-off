[0.041, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat it proposes:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mS\u001b[7Gack:\u001b[22m Node 24,\u001b[21GTypeScript\u001b[32Gin\u001b[35Gstrict\u001b[42Gmode,\u001b[48GFastify\u001b[56G5\u001b[58Gfor\u001b[62Gthe\u001b[66Gserver\u001b[73Gand\u001b[77GVitest\u001b[84G3\u001b[86Gfor\u001b[90Gtests.\u001b[97GData\u001b[102Gis\u001b[105Gkept\u001b[110Gin\u001b[113Gmemory\u001b[120Gbehind\u001b[127Ga\u001b[129Gstorage\u001b[137Ginterface,\u001b[148Gso\u001b[151Gthere's\u001b[159Gno\r\u001b[2C\u001b[1B \u001b[5Gdatabase.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMoney:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Internally\u001b[18Gevery\u001b[24Gamount\u001b[31Gis\u001b[34Ga\u001b[36Gwhole\u001b[42Gnumber\u001b[49Gof\u001b[52Gcents,\u001b[59Gand\u001b[63Gno\u001b[66Gdecimal\u001b[74Garithmetic\u001b[85Gis\u001b[88Gused\u001b[93Ganywhere\u001b[102Gmoney\u001b[108Gis\u001b[111Gcalculated.\r\u001b[6C\u001b[1BAmounts go\u001b[18Gin and out of the\u001b[36GAPI as strings like \u001b[38;2;177;185;249m\"10.00\"\u001b[39m. A request that sends the amou\u001b[95Gt as a\u001b[102Gplain\u001b[108Gnumber is r\u001b[120Gjected.\r\u001b[6C\u001b[1BIn a\u001b[12G equal split, leftover cents go one each to\u001b[56Gthe first member\u001b[73G listed, so €10.00 split three ways is 3.34 / 3.33 / 3.33.\r\u001b[6C\u001b[1BBal\u001b[12Gc\u001b[14Gs \u001b[18Gways add up to exactly\u001b[41Gzer\u001b[45G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEndpo"]
[0.002, "o", "ints:\u001b[16G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mPOST /groups\u001b[20G\u001b[39mand\u001b[24G\u001b[38;2;177;185;249mGET /groups/:id\r\u001b[18C\u001b[1B/:id/members\u001b[39m\u001b[K\r\u001b[10C\u001b[1B and \u001b[38;2;177;185;249mGET /groups/:id/expenses\r\u001b[6C\u001b[1BGET /groups/:id/balances\u001b[39m\u001b[K\r\u001b[22C\u001b[1B\u001b[38;2;177;185;249msettle-up\r\u001b[2C\u001b[1B\u001b[39m-\u001b[5G\u001b[1mSplits stored per member:\u001b[22m each\u001b[36Gexpense\u001b[44Gsaves\u001b[50Gexactly\u001b[58Ghow\u001b[62Gmany\u001b[67Gcents\u001b[73Geach\u001b[78Gmember\u001b[85Gowes.\u001b[91GUnequal\u001b[99Gsplits\u001b[106Gcan\u001b[110Gbe\u001b[113Gadded\u001b[119Glater\u001b[125Gwithout\u001b[133Gchanging\u001b[142Gthe\u001b[146Gbalances\u001b[155Gresponse.\r\u001b[5C\u001b[1B\u001b[1mettle-up:\u001b[22m it finds the true minimum number of transfers\u001b[62Gwhen\u001b[67Gup \u001b[71Go\u001b[73G20 me\u001b[79Gbers hav\u001b[88G a\u001b[91Gnon-zero balance. A\u001b[111Gove that i\u001b[122G falls back to a simpl\u001b[145Gr method that may\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gsuggest a few\u001b[19Gextra\u001b[26Gransfers.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTests:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Unit\u001b[12Gtests\u001b[18Gfor\u001b[22Gthe\u001b[26Gmoney,\u001b[33Gsplit,\u001b[40Gbalance\u001b[48Gand\u001b[52Gsettle-up\u001b[62Glogic.\r\u001b[6C\u001b[1BTes\u001b[11Gs that\u001b[18Grun\u001b[22Gse\u001b[25Gde"]
[0.001, "o", "d random groups \u001b[45Gd check that shares add\u001b[69Gup\u001b[72Gto\u001b[75Geach\u001b[80Gexpense,\u001b[89Gbalances\u001b[98Gadd\u001b[102Gup\u001b[105Gto\u001b[108Gzero,\u001b[114Gand\u001b[118Gthe\u001b[122Gtransfers\u001b[132Gclear\u001b[138Gevery\u001b[144Gdebt.\r\u001b[6C\u001b[1BOn small random groups, the transfer count is\u001b[53Gcompared against a\u001b[72Gbrute-force ch\u001b[87Gck of th\u001b[96G true\u001b[102Gminimum.\u001b[K\r\u001b[6C\u001b[1BTests that call\u001b[23Gevery endpoint through Fast\u001b[51Gfy without\u001b[62Gst\u001b[65Grting a server, including eac\u001b[95G er\u001b[99Gor\u001b[102Gcase.\u001b[K\r\u001b[6C\u001b[1BCoverage \u001b[17Garget: at least 90% ove\u001b[41Gall,\u001b[46Gand 100% for the money, split and sett\u001b[85Ge-up code.\u001b[96G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOpen questions:\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mLogin:\u001b[22m should\u001b[20GI\u001b[22Gskip\u001b[27Gauthentication\u001b[42Gentirely\u001b[51Gand\u001b[55Gaccept\u001b[62Gany\u001b[66Gcaller?\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mStorage:\u001b[22m is in-memory fin\u001b[32G, or do you want SQLite so dat\u001b[63G surviv\u001b[71Gs a\u001b[75Grestart?\r\u001b[2C\u001b[1B3\u001b[7G\u001b[1mettle-up:\u001b[22m do you want th\u001b[32G exact minimum (more work), or i\u001b[65G the simpler method\u001b[85Gfine?\u001b[91GIt\u001b[94Gnever\u001b[100Gneeds\u001b[106"]
