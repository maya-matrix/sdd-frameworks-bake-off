[0.046, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[29S\u001b[r\u001b[H     \u001b[38;2;248;248;242m\u001b[2m 10 \u001b[22m4. **Money travels as decimal strings** in JSON (`\"10.00\"`), never JSON numbers, so clients can't introduce float error. Internally all money is **int\r\u001b[4B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mI've written the spec draft to \u001b[38;2;177;185;249maddy/SPEC.md\u001b[39m.\u001b[48GNo\u001b[51Gcode\u001b[56Gor\u001b[59Gplan\u001b[64Gyet;\u001b[69GI'm\u001b[73Gwaiting\u001b[81Gfor\u001b[85Gyour\u001b[90Gapproval\u001b[99Gfirst.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it proposes:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mStack:\u001b[12G\u001b[22mNode\u001b[17G24,\u001b[21GTypeScript\u001b[32Gin\u001b[35Gstrict\u001b[42Gmode,\u001b[48GFastify\u001b[56G5\u001b[58Gfor\u001b[62Gthe\u001b[66Gserver\u001b[73Gand\u001b[77GVitest\u001b[84G3\u001b[86Gfor\u001b[90Gtests.\u001b[97GData\u001b[102Gis\u001b[105Gkept\u001b[110Gin\u001b[113Gmemory\u001b[120Gbehind\u001b[127Ga\u001b[129Gstorage\u001b[137Ginterface,\u001b[148Gso\u001b[151Gthere's\u001b[159Gno\r\u001b[4C\u001b[1Bdatabase.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMoney:\r\u001b[4C\u001b[1B\u001b[22m-\u001b[7GInternally\u001b[18Gevery\u001b[24Gamount\u001b[31Gis\u001b[34Ga\u001b[36Gwhole\u001b[42Gnumber\u001b[49Gof\u001b[52Gcents,\u001b[59Gand\u001b[63Gno\u001b[66Gdecimal\u001b[74Garithmetic\u001b[85Gis\u001b[88Gused\u001b[93Ganywhere\u001b[102Gmoney\u001b[108Gis\u001b[111Gcalculated."]
