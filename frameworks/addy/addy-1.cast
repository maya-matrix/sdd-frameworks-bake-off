[0.017, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1T\u001b[r\u001b[H\u001b[8G\u001b[38;2;248;248;242m\u001b[2m7\u001b[10G\u001b[22m1. **No\u001b[18Gauthen\u001b[25Gication.** \"Any member can record an expense\" means the API trusts the caller; payer and participants must be members of the group, but\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m caller identity is not verified.\r\u001b[70C\u001b[33B\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (click) ↓ \u001b[39m\u001b[49m\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[1.472, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;35r\u001b[1S\u001b[r\u001b[H\u001b[8G\u001b[38;2;248;248;242m\u001b[2m \u001b[10G\u001b[22m caller\u001b[18Gidenti\u001b[25Gy is not verified.\u001b[39m\u001b[K\r\u001b[70C\u001b[33Br?\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mStorage:\u001b[15G\u001b[22mis\u001b[18Gin-memory\u001b[28Gfine,\u001b[34Gor\u001b[37Gdo\u001b[40Gyou\u001b[44Gwant\u001b[49GSQLite\u001b[56Gso\u001b[59Gdata\u001b[64Gsurvive\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (click) ↓ \u001b[39m\u001b[49m\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
