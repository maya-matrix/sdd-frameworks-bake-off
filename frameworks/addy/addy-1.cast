[0.004, "o", "\u001b[?2026h\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWha\u001b[7G's there:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mEndpoints:\u001b[16G\u001b[22mcreate and\u001b[27Gread groups, add members, record and\u001b[64Glist\u001b[69Gexpenses,\u001b[79Gnet\u001b[83Gbalances\u001b[92Gper\u001b[96Gmember,\u001b[104Gand\u001b[108Gsettle-up.\r\u001b[4C\u001b[1B\u001b[1mExact money:\u001b[22m all\u001b[22Gam\u001b[25Gunts\u001b[30Gare whole cents internally. The API acc\u001b[70Gpts and returns \u001b[87Gtrings like \u001b[38;2;177;185;249m\"10.50\"\u001b[39m and rejects plain JSON numbers. Leftover cents go to the\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gfirst\u001b[11Gmembers\u001b[19Glisted, so €10.00 split three ways is 3.34\u001b[62G/ 3.33 / 3.33.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mStorage:\u001b[22m SQLite, so\u001b[25Gdata\u001b[30Gsurvives\u001b[39Ga\u001b[41Grestart.\u001b[50GA\u001b[52Gtest\u001b[57Gconfirms\u001b[66Gthis,\u001b[72Gand\u001b[76GI\u001b[78Gchecked\u001b[86Gthat\u001b[91Gthe\u001b[95Gtest\u001b[100Gfails\u001b[106Gif\u001b[109Gthe\u001b[113Gsecond\u001b[120Gapp\u001b[124Ginstance\u001b[133Gopens\u001b[139Ga\u001b[141Gdifferent\u001b[151Gdatabase\u001b[160Gfile.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mErrors:\u001b[13G\u001b[22mevery\u001b[19Gfailure\u001b[27Greturns\u001b[35G\u001b[38;2;177;185;249m{\"error\": {\"code\", \"message\"}}\u001b[39m,\u001b[67Gwith\u001b[72Gthe\u001b[76GHTTP\u001b[81Gstatus\u001b[88Gchosen\u001b[95Gas\u001b[98Gyou\u001b["]
[0.011, "o", "102Gapproved.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests (133 to\u001b[17Gal):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GUnit test\u001b[16Gfor money, splitting, balances\u001b[47Gand\u001b[51Gsettle-up.\r\u001b[2C\u001b[1B-\u001b[5GRandomized tests\u001b[22Gshowing\u001b[30Gthat\u001b[35Gs\u001b[38Gres always\u001b[49Gadd up to the expense, bal\u001b[76Gnces alw\u001b[85Gys add up\u001b[95Gto zero, and the settle-up transfer c\u001b[133Gunt ma\u001b[140Gches a brute-force minimum.\r\u001b[2C\u001b[1B-\u001b[5GTests through the HTTP\u001b[28GAPI for every endpoin\u001b[50G, \u001b[53Gncluding each error case.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe restar\u001b[16G test.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to look at:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1\u001b[6G\u001b[1mYou\u001b[10Gh\u001b[12Gven't\u001b[18Greviewed the settle-up algorithm yet.\u001b[22m The plan\u001b[65Ghad a stop\u001b[76Gafter Task 3\u001b[89Gfor you\u001b[97Gto review it, but \u001b[38;2;177;185;249m/build auto\u001b[39m runs without stopp\u001b[146Gng, so\u001b[153GI marked that\r\u001b[5C\u001b[1Br\u001b[8Gview as deferred\u001b[25Gin\u001b[28G\u001b[38;2;177;185;249mtasks/todo.md\u001b[39m.\r\u001b[2C\u001b[1B  \u001b[6G-\u001b[8GThe algorithm differs from what\u001b[40Gthe plan descr\u001b[55Gbed. The plain approach\u001b[79Gtook\u001b[84Gabout\u001b[90G1.9s\u001b[95Gwith\u001b[100G2"]
