[0.002, "o", "\u001b[?2026h\u001b[H\u001b[2;32r\u001b[1S\u001b[r\u001b[H\u001b[3G-\u001b[5G\u001b[1mEndpoints:\u001b[16G\u001b[22mcreate\u001b[23Gand\u001b[27Gread\u001b[32Ggroups,\u001b[40Gadd\u001b[44Gmembers,\u001b[53Grecord\u001b[60Gand\u001b[64Glist\u001b[69Gexpenses,\u001b[79Gnet\u001b[83Gbalances\u001b[92Gper\u001b[96Gmember,\u001b[104Gand\u001b[108Gsettle-up.\r\u001b[5C\u001b[1B\u001b[1mxact money:\u001b[22m all amounts are whole\u001b[40Gcents internally. The API acc\u001b[70Gpts and returns strings lik\u001b[98G \u001b[38;2;177;185;249m\"10.50\"\u001b[39m and rejects\u001b[119Gplain\u001b[125GJSON\u001b[130Gnumbers.\u001b[139GLeftover\u001b[148Gcents\u001b[154Ggo\u001b[157Gto\u001b[160Gthe\r\u001b[2C\u001b[1B \u001b[5Gfirst members \u001b[20Gisted, so\u001b[30G€10.00 split \u001b[44Ghree ways is 3.34\u001b[62G/ 3.33 / 3.33.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStorage:\u001b[22m SQLite, so data\u001b[30Gsurvive\u001b[38G a restart. A test\u001b[57Gconfirms this, and I\u001b[78Gchecked\u001b[86Gthat\u001b[91Gthe\u001b[95Gtest\u001b[100Gfails\u001b[106Gif\u001b[109Gthe\u001b[113Gsecond\u001b[120Gapp\u001b[124Ginstance\u001b[133Gopens\u001b[139Ga\u001b[141Gdifferent\u001b[151Gdatabase\u001b[160Gfile.\r\u001b[4C\u001b[1B\u001b[1mErrors:\u001b[22m every failure returns \u001b[38;2;177;185;249m{\"error\": {\"code\", \"message\"}}\u001b[39m, w\u001b[69Gth\u001b[72Gthe\u001b[76GHTTP status chosen\u001b[95Gas you approved.\u001b[K\r\u001b[2C\u001b[1B"]
[0.002, "o", "\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests (133 total):\r\u001b[2C\u001b[1B\u001b[22m- Unit tests for money,\u001b[27Gsplitting,\u001b[38Gbalances\u001b[47Gand\u001b[51Gsettle-up.\r\u001b[4C\u001b[1BRandomized\u001b[16Gtests showing that shares always add up to the\u001b[63Gexpense,\u001b[72Gbalances\u001b[81Galways\u001b[88Gadd\u001b[92Gup\u001b[95Gto\u001b[98Gzero,\u001b[104Gand\u001b[108Gthe\u001b[112Gsettle-up\u001b[122Gtransfer\u001b[131Gcount\u001b[137Gmatches\u001b[145Ga\u001b[147Gbrute-force\u001b[159Gminimum.\r\u001b[4C\u001b[1BTests through \u001b[20Ghe HTTP API for every\u001b[42Gendpoint, including each error case.\u001b[K\r\u001b[5C\u001b[1Bhe restart test.\u001b[23G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to look at:\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mYou\u001b[10Ghaven't\u001b[18Greviewed the settle-up algorithm yet.\u001b[56G\u001b[22mThe\u001b[60Gplan\u001b[65Ghad\u001b[69Ga\u001b[71Gstop\u001b[76Gafter\u001b[82GTask\u001b[87G3\u001b[89Gfor\u001b[93Gyou\u001b[97Gto\u001b[100Greview\u001b[107Git,\u001b[111Gbut\u001b[115G\u001b[38;2;177;185;249m/build auto\u001b[127G\u001b[39mruns\u001b[132Gwithout\u001b[140Gstopping,\u001b[150Gso\u001b[153GI\u001b[155Gmarked\u001b[162Gthat\r\u001b[2C\u001b[1B  \u001b[6Greview as deferred in \u001b[38;2;177;185;249mtasks/todo.md\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B- Th\u001b[11G algorithm differs from what the\u001b[44Gplan\u001b[49Gdescribed.\u001b[60GThe\u001b[64Gpla"]
[0.001, "o", "in\u001b[70Gapproach\u001b[79Gtook\u001b[84Gabout\u001b[90G1.9s\u001b[95Gwith\u001b[100G20\u001b[103Gmembers\u001b[111Gowing\u001b[117Gor\u001b[120Gowed,\u001b[126Gtoo\u001b[130Gclose\u001b[136Gto\u001b[139Gthe\u001b[143G2s\u001b[146Gbudget.\u001b[154GSo\u001b[157G\u001b[38;2;177;185;249msettle.py\r\u001b[5C\u001b[1B\u001b[39m \u001b[8Ggets the same\u001b[22Gexact answer\u001b[35Gusing whole-set bit operations instead, which takes about 0.15s at that size.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GB\u001b[10Gyond the built-in\u001b[28Gte\u001b[31Gts,\u001b[35GI ran\u001b[41G3,000 random cas\u001b[58Gs against an independen\u001b[82G brute-force check,\u001b[102Gand all matched.\r\u001b[7C\u001b[1BWith more than 20 member\u001b[33G owing or owed, it fall\u001b[57G back to a\u001b[68Gsimpler method\u001b[83Gtha\u001b[87G still clears every debt but may\u001b[120Gsuggest\u001b[128Gmore\u001b[133Gtransfers\u001b[143Gthan\u001b[148Gthe\u001b[152Gminimum.\u001b[161GThe\r\u001b[5C\u001b[1B \u001b[8GREADME docume\u001b[22Gts this.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mOne warning in the test runs:\u001b[36G\u001b[22mStarlette\u001b[46Gnow\u001b[50Gprefers\u001b[58G\u001b[38;2;177;185;249mhttpx2\u001b[65G\u001b[39mover\u001b[70G\u001b[38;2;177;185;249mhttpx\u001b[76G\u001b[39mfor\u001b[80Gits\u001b[84Gtest\u001b[89Gclient.\u001b[97GI\u001b[99Gdidn't\u001b[106Gswitch\u001b[113Gbecause\u001b[121Gadding\u001b[128Ga\u001b[13"]
